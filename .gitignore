# Build output
/target

# Unpacked wheel (produced by `maturin build --features python`, then unzipped).
# The whole directory is build output; the earlier `/pybuild/*.so` missed the
# package subdirectory the wheel actually puts the module in, so a 1.6 MB
# binary was tracked and re-diffed on every rebuild.
/pybuild/
build/
*.so
*.c
.DS_Store

# Agent worktrees (tool-managed checkouts, not part of the tree).
# .claude/settings.json IS tracked — it is the shared permission allowlist.
/.claude/worktrees/

# Scratch target dirs for A/B builds (see docs/record/failure-and-overflow.md,
# which measures two builds of the same tree against each other).
/target-*

# Sage's preparse cache. `gen_sage_oracle.sage.py` was tracked and went stale
# the first time the generator's sweep floors changed: Sage 10.9 runs the
# `.sage` directly and no longer rewrites the `.py` beside it, so the committed
# copy silently encoded the old floors. A stale generator is the drift V4
# guards against (docs/policies/validation.md), so the artifact is not tracked.
*.sage.py

# Working file for `scripts/doc_review.py` — a worksheet of every rustdoc
# paragraph with a comment slot under each. Personal review notes, regenerated
# on demand; the edits it produces are what gets committed.
/doc-review.txt

# Python bytecode from the check and bench scripts.
__pycache__/

# The compiled half of the wheel, staged into the source package so the check
# scripts and the documentation build can import `symfn` from the tree without
# maturin or an install. `cargo build --features python` produces it and
# `scripts/check_convenience_docs.py` copies it; it is build output, and a
# tracked binary would be re-diffed on every rebuild.
/python/symfn/symfn*.so
/python/symfn/symfn*.dylib
/python/symfn/symfn*.pyd

# The offline source distribution and the vendored crate sources it carries.
# `scripts/build_sdist.sh` writes both and removes them again; these entries
# are the safety net for an interrupted run, so an 18 MB tree of other
# people's crates cannot be committed by accident.
/dist/
/vendor/
/.cargo/config.toml.sdist-backup

# The rendered documentation. Read the Docs builds it from source; a local
# build exists only to run `scripts/check_docs_complete.py` against.
/docsite/_build/
